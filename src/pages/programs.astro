---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, programs, accents, faqs } from '../data/site';
import little from '../assets/photos/g-collage-space.jpg';
import lab from '../assets/photos/g-mixed-media-astronaut.jpg';
import intensive from '../assets/photos/g-character-study.jpg';
import studio from '../assets/photos/programs-studio.jpg';
import schoolsA from '../assets/photos/strip-2.jpg';
import schoolsB from '../assets/photos/strip-3.jpg';

const photos = [
  { src: little, alt: 'Collage in space, student artwork', caption: 'collage week' },
  { src: lab, alt: 'Mixed-media astronaut, student artwork', caption: 'mixed media, week 9' },
  { src: intensive, alt: 'Character study in paper and thread, student artwork', caption: 'character study' },
];
const anchors = ['little', 'lab', 'intensive'];
---
<BaseLayout title="Programs" description="Little Studio (6–8), Mixed Media Lab (9–12), Drawing Intensive (13–17) and on-site workshops for schools. 10-week terms, materials included.">
  <section class="wrap pb-[clamp(40px,6vw,72px)] pt-[clamp(32px,5vw,64px)]">
    <p class="note-intro">programs —</p>
    <h1 class="h1 max-w-[18ch]">Four ways to spend a week making something.</h1>
    <p class="mb-6 max-w-[56ch] text-body">Terms run 10 weeks. Materials, aprons and framing for the end-of-term show are included. Try a single session before you commit to the term.</p>
    <nav aria-label="Jump to a program" class="flex flex-wrap gap-2.5">
      {programs.map((p, i) => (
        <a href={`#${anchors[i]}`} class="rounded-full border-2 bg-white px-4 py-1.5 font-hand text-[22px] text-strong no-underline" style={`border-color:${accents[p.accent].border}`}>{p.ages.replace('Ages ', '')}</a>
      ))}
      <a href="#schools" class="rounded-full border-2 border-strong bg-white px-4 py-1.5 font-hand text-[22px] text-strong no-underline">schools</a>
    </nav>
  </section>

  {programs.map((p, i) => (
    <section id={anchors[i]} class="wrap section grid grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] items-center gap-[clamp(32px,5vw,64px)]">
      <figure class:list={['polaroid', i % 2 ? 'rotate-2 min-[760px]:order-2' : '-rotate-2']}>
        <div class="tape" style={`background:${accents[p.accent].tape}`}></div>
        <Image src={photos[i].src} alt={photos[i].alt} widths={[500, 900]} sizes="(min-width: 760px) 45vw, 90vw" class="aspect-[4/3] w-full object-cover" />
        <figcaption>{photos[i].caption}</figcaption>
      </figure>
      <div>
        <p class="font-hand text-[28px]" style={`color:${accents[p.accent].label}`}>
          {p.ages.toLowerCase()}
          {p.highlight && <span class="ml-1 rounded-md bg-tint-chip px-2 text-magenta">{p.highlight}</span>}
        </p>
        <h2 class="mb-3 text-[clamp(30px,3vw,40px)]">{p.name}</h2>
        <p class="mb-[18px] max-w-[48ch] text-body">{p.description}</p>
        <ul class="mb-5 grid gap-1.5 text-[15px] text-strong">
          <li><strong>When:</strong> {p.chips.join(', ')}</li>
          <li><strong>Group:</strong> up to 8</li>
          {site.showPricing && <li><strong>Term:</strong> £{p.price} for 10 weeks, materials included</li>}
        </ul>
        <a href="/contact" class="btn-primary">Book a {p.name} trial</a>
      </div>
    </section>
  ))}

  <section id="schools" class="wrap section">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] items-center gap-[clamp(28px,4vw,52px)] rounded-[18px] border border-tint-border bg-tint p-[clamp(28px,4vw,52px)]">
      <div>
        <p class="note">schools &amp; groups</p>
        <h2 class="mb-3 text-[clamp(30px,3vw,40px)]">Workshops, on your site</h2>
        <p class="mb-[18px] max-w-[48ch] text-body">A single session or a half-term residency, mapped to your curriculum aims and delivered in your hall or art room. Everything arrives with Mae: materials, cover sheets, risk assessment, clean-up.</p>
        <p class="mb-5 text-[15px] text-strong"><strong>60–120 minutes</strong> · <strong>up to 30 students</strong> · Enhanced DBS</p>
        <a href="/contact?type=school" class="btn-primary">Request a quote</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <Image src={schoolsA} alt="Student artwork from a workshop" widths={[300, 600]} sizes="25vw" class="aspect-square w-full -rotate-2 rounded-lg object-cover" />
        <Image src={schoolsB} alt="Student artwork from a workshop" widths={[300, 600]} sizes="25vw" class="aspect-square w-full rotate-2 rounded-lg object-cover" />
      </div>
    </div>
  </section>

  <section class="wrap section grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] items-start gap-[clamp(32px,5vw,64px)]">
    <div>
      <h2 class="h2 mb-5">Questions parents ask</h2>
      {faqs.map((f, i) => (
        <details class:list={['border-t border-outline py-4', i === faqs.length - 1 && 'border-b']}>
          <summary class="cursor-pointer text-[17px] font-bold">{f.q}</summary>
          <p class="mt-2.5 text-body">{f.a}</p>
        </details>
      ))}
    </div>
    <figure class="polaroid rotate-1">
      <div class="tape" style={`background:${accents.orange.tape}`}></div>
      <Image src={studio} alt="The studio set up for a class" widths={[500, 900]} sizes="(min-width: 760px) 45vw, 90vw" class="aspect-[3/2] w-full object-cover" />
      <figcaption>the studio, ready for Saturday</figcaption>
    </figure>
  </section>
</BaseLayout>
