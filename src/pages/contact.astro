---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const fields = [
  { name: 'name', label: 'Your name', placeholder: 'First and last', required: true },
  { name: 'email', label: 'Email', placeholder: 'you@example.com', type: 'email' as const, required: true },
  { name: 'details', label: "Child's age", placeholder: 'e.g. 9' },
];
---
<BaseLayout title="Contact" description="Book a trial session, a studio visit or a school workshop. Mae answers every message herself, usually within a day.">
  <div class="wrap section grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] items-start gap-[clamp(40px,6vw,80px)] pt-[clamp(32px,5vw,72px)]">
    <div>
      <p class="note-intro">say hello —</p>
      <h1 class="h1">Tell me who's coming.</h1>
      <p class="mb-8 max-w-[44ch] text-body">I answer every message myself, usually within a day. If you'd rather just come and look at the room first, say so — that's the most common way people start.</p>
      <div class="grid max-w-[40ch] gap-[22px]">
        <div>
          <p class="font-hand text-2xl text-orange-text">studio</p>
          <p>{site.studio.map((line) => <>{line}<br /></>)}</p>
        </div>
        <div>
          <p class="font-hand text-2xl text-orange-text">email</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div>
          <p class="font-hand text-2xl text-orange-text">instagram</p>
          <a href={site.instagram}>{site.instagramHandle}</a>
        </div>
      </div>
    </div>

    <div class="relative rounded-xl border border-outline bg-white p-[clamp(24px,3.5vw,40px)] shadow-[0_10px_28px_rgba(25,23,32,0.07)]">
      <div class="tape left-[42%] -rotate-2 bg-magenta/25"></div>
      <div id="sent" hidden class="px-2 py-8 text-center">
        <p class="font-hand text-[40px] text-magenta">thank you!</p>
        <h2 class="mb-2.5 text-2xl">That's with me now.</h2>
        <p class="text-[15px] text-body">I'll reply from {site.email} within a day, usually sooner.</p>
      </div>

      <form id="enquiry" action={`https://formsubmit.co/${site.email}`} method="POST" novalidate>
        <input type="hidden" name="_subject" value="New enquiry from maeclassroom.com" />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
        <fieldset class="mb-[22px]">
          <legend class="mb-2 text-sm text-body">I'm enquiring as a</legend>
          <div class="flex flex-wrap gap-2">
            {[['family', 'Parent or guardian'], ['school', 'School or group']].map(([value, label], i) => (
              <label class="cursor-pointer">
                <input type="radio" name="enquiring_as" value={label} data-type={value} checked={i === 0} class="peer sr-only" />
                <span class="flex min-h-11 items-center rounded-full border-2 border-tint-input bg-white px-[18px] text-[15px] font-semibold text-body transition-colors duration-150 peer-checked:border-magenta peer-checked:bg-magenta peer-checked:text-white peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-magenta">{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="grid gap-4">
          {fields.map((f) => (
            <div>
              <label for={f.name} class="mb-1.5 block text-[13px] font-semibold text-body">{f.label}</label>
              <input id={f.name} name={f.name} type={f.type ?? 'text'} placeholder={f.placeholder} required={f.required} class="field" />
              <p class="mt-1 text-[13px] text-red-text" data-error hidden></p>
            </div>
          ))}
          <div>
            <label for="message" class="mb-1.5 block text-[13px] font-semibold text-body">What would you like to know?</label>
            <textarea id="message" name="message" required placeholder="Which program you're interested in, any questions, or just say hello." class="field min-h-[110px] resize-y"></textarea>
            <p class="mt-1 text-[13px] text-red-text" data-error hidden></p>
          </div>
          <button type="submit" class="btn bg-magenta p-3.5 text-white hover:bg-magenta-dark disabled:opacity-60">Send to Mae</button>
          <p id="form-error" hidden class="text-center text-[13px] text-red-text">
            Sorry, that didn't send. Please email <a href={`mailto:${site.email}`}>{site.email}</a> instead.
          </p>
          <p class="text-center font-hand text-[22px] text-body">no mailing list, no forwarding — just a reply from me</p>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement;
  const details = form.elements.namedItem('details') as HTMLInputElement;
  const detailsLabel = form.querySelector('label[for="details"]')!;

  const setType = (type: string) => {
    const school = type === 'school';
    detailsLabel.textContent = school ? 'School or organisation' : "Child's age";
    details.placeholder = school ? 'Name, and roughly how many students' : 'e.g. 9';
  };
  form.querySelectorAll<HTMLInputElement>('input[name="enquiring_as"]').forEach((r) => {
    r.addEventListener('change', () => setType(r.dataset.type!));
  });
  if (new URLSearchParams(location.search).get('type') === 'school') {
    form.querySelector<HTMLInputElement>('[data-type="school"]')!.checked = true;
    setType('school');
  }

  const messages: Record<string, string> = {
    name: 'Please tell me your name.',
    email: 'Please enter a valid email address.',
    message: 'Please add a short message.',
  };
  const validate = () => {
    let ok = true;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]').forEach((el) => {
      const error = el.parentElement!.querySelector<HTMLElement>('[data-error]')!;
      const valid = el.value.trim() !== '' && el.checkValidity();
      error.textContent = messages[el.name];
      error.hidden = valid;
      el.setAttribute('aria-invalid', String(!valid));
      if (!valid && ok) { el.focus(); ok = false; }
    });
    return ok;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    const button = form.querySelector('button')!;
    const formError = document.getElementById('form-error')!;
    button.disabled = true;
    button.textContent = 'Sending…';
    formError.hidden = true;
    try {
      const res = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
        method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' },
      });
      // formsubmit can answer 200 with { success: "false" }, e.g. before the address is activated
      const data = await res.json();
      if (!res.ok || String(data.success) !== 'true') throw new Error(data.message);
      form.hidden = true;
      document.getElementById('sent')!.hidden = false;
    } catch {
      formError.hidden = false;
      button.disabled = false;
      button.textContent = 'Send to Mae';
    }
  });
</script>
