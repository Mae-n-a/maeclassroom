---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import myImage from "../assets/all-combined.webp";

---

<BaseLayout title="Home">
  <div class="flex flex-col text-center md:text-left md:flex-row w-full items-center p-4">
    <div class="md:w-1/3">
      <h1 class="text-4xl font-extrabold leading-normal pb-4 bg-gradient-to-r from-primary-500 via-cyan-700 to-accent-400 inline-block text-transparent bg-clip-text">Mae's Creative<br>Classroom</h1>
      <h2 class="text-2xl font-semibold text-gray-800 leading-tight pb-4">Unlock Your Creativity with Personalized Art Programs</h2>
      <div class="pb-4">
        <p>Discover unique art experiences through engaging programs, mixed media, and drawing programs guided by professional art teachers.</p>
        <br>
        <p>At Mae's Creative Classroom, we believe that everyone has a natural talent to create wonderful artwork, and our mission is to provide the tools, guidance, and inspiration to unleash that creativity.</p>
      </div>
      <a href="/programs" class="relative inline-flex items-center justify-center p-0.5 mb-2 me-2 overflow-hidden text-lg font-medium text-primary-500 rounded-lg group bg-gradient-to-br from-pink-500 to-orange-400 group-hover:from-pink-500 group-hover:to-orange-400 hover:text-white dark:text-white focus:ring-4 focus:outline-none focus:ring-pink-200 dark:focus:ring-pink-800 ">
        <span class="relative px-5 py-2.5 transition-all ease-in duration-75 bg-white dark:bg-gray-900 rounded-md group-hover:bg-opacity-0">
        Discover Programs
        </span>
      </a>
    </div>
    <div class="md:w-2/3">
      <div class="masonry-gallery w-[70vw] h-[70vw] md:w-[70vh] md:h-[70vh] overflow-hidden mx-auto relative">
        <div class="absolute top-0 left-0 w-full h-full bg-gray-200 animate-pulse"></div>
        <Picture
          src={myImage}
          alt="A description of my image"
          class="transform transition-transform hover:scale-150 hover:rotate-2"
          widths={[720, 1080, 1440, myImage.width]}
          sizes={`(max-width: 720px) 720px, (max-width: 1080px) 1080px, (max-width: 1440px) 1440px, ${myImage.width}px`}
          formats={['avif', 'webp']}
          loading={"eager"}
          onload="document.querySelector('.animate-pulse')?.classList.remove('bg-gray-200', 'animate-pulse')"
        />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .masonry-gallery {
    -webkit-mask-image: url('/images/mask.svg');
    mask-image: url('/images/mask.svg');
    -webkit-mask-size: cover;
    mask-size: cover;
    -webkit-mask-position: center;
    mask-position: center;
  }
</style>
